{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:holon:schema:publication:openid-credential-issuer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "credential_issuer",
    "credential_endpoint",
    "credential_configurations_supported"
  ],
  "properties": {
    "credential_issuer": {
      "type": "string",
      "format": "uri"
    },
    "credential_endpoint": {
      "type": "string",
      "format": "uri"
    },
    "nonce_endpoint": {
      "type": "string",
      "format": "uri"
    },
    "deferred_credential_endpoint": {
      "type": "string",
      "format": "uri"
    },
    "authorization_servers": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "display": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "credential_configurations_supported": {
      "type": "object",
      "minProperties": 1
    }
  }
}
