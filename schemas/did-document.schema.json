{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:holon:schema:publication:did-document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "@context",
    "id",
    "verificationMethod",
    "assertionMethod",
    "authentication",
    "service"
  ],
  "properties": {
    "@context": {
      "const": [
        "https://www.w3.org/ns/did/v1",
        "https://w3id.org/security/multikey/v1"
      ]
    },
    "id": {
      "type": "string",
      "format": "uri"
    },
    "verificationMethod": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "controller",
          "type",
          "publicKeyMultibase"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uri"
          },
          "controller": {
            "type": "string",
            "format": "uri"
          },
          "type": {
            "const": "Multikey"
          },
          "publicKeyMultibase": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "assertionMethod": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "authentication": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "service": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "serviceEndpoint"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uri"
          },
          "type": {
            "const": "HolonIssuerMetadata"
          },
          "serviceEndpoint": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "minItems": 1,
      "uniqueItems": true
    }
  }
}
