{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:holon:schema:1.0:disclosure",
  "title": "Holon 1.0",
  "type": "object",
  "required": [
    "id",
    "type",
    "schemaVersion"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uri"
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "const": "1.0"
    },
    "claims": {
      "type": "object"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uri"
        },
        "kind": {
          "type": "string"
        },
        "uri": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uri"
          },
          "type": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "format": "uri"
          },
          "digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "claimPaths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "relatedHolons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "relation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uri"
          },
          "relation": {
            "type": "string",
            "format": "uri"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
