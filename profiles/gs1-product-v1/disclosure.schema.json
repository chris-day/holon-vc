{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gs1-product.perdl.com/schemas/product-holon-v1",
  "title": "Shared Schema.org product Holon",
  "type": "object",
  "required": [
    "id",
    "type",
    "schemaVersion",
    "claims"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uri"
    },
    "type": {
      "const": "ProductHolon"
    },
    "schemaVersion": {
      "const": "1.0"
    },
    "claims": {
      "type": "object",
      "required": [
        "product"
      ],
      "properties": {
        "product": {
          "type": "object",
          "properties": {
            "@id": {
              "type": "string",
              "format": "uri",
              "minLength": 1
            },
            "@type": {
              "anyOf": [
                {
                  "const": "Product"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "contains": {
                    "const": "Product"
                  }
                }
              ]
            },
            "additionalProperty": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "@type": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "value": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "string"
                      }
                    ]
                  }
                },
                "additionalProperties": false
              }
            },
            "brand": {
              "type": "object",
              "properties": {
                "@type": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "category": {
              "type": "string"
            },
            "color": {
              "type": "string"
            },
            "depth": {
              "type": "object",
              "properties": {
                "@type": {
                  "type": "string"
                },
                "unitCode": {
                  "type": "string"
                },
                "value": {
                  "type": "number"
                }
              },
              "additionalProperties": false
            },
            "description": {
              "type": "string"
            },
            "gtin14": {
              "type": "string",
              "pattern": "^[0-9]{14}$"
            },
            "height": {
              "type": "object",
              "properties": {
                "@type": {
                  "type": "string"
                },
                "unitCode": {
                  "type": "string"
                },
                "value": {
                  "type": "number"
                }
              },
              "additionalProperties": false
            },
            "image": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "model": {
              "type": "string"
            },
            "mpn": {
              "type": "string"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "offers": {
              "type": "object",
              "properties": {
                "@id": {
                  "type": "string"
                },
                "@type": {
                  "type": "string"
                },
                "availability": {
                  "type": "string"
                },
                "hasMerchantReturnPolicy": {
                  "type": "object",
                  "properties": {
                    "@type": {
                      "type": "string"
                    },
                    "applicableCountry": {
                      "type": "string"
                    },
                    "returnPolicyCategory": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                },
                "itemCondition": {
                  "type": "string"
                },
                "price": {
                  "type": "string"
                },
                "priceCurrency": {
                  "type": "string"
                },
                "priceValidUntil": {
                  "type": "string"
                },
                "seller": {
                  "type": "object",
                  "properties": {
                    "@id": {
                      "type": "string"
                    },
                    "@type": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                },
                "shippingDetails": {
                  "type": "object",
                  "properties": {
                    "@type": {
                      "type": "string"
                    },
                    "deliveryTime": {
                      "type": "object",
                      "properties": {
                        "@type": {
                          "type": "string"
                        },
                        "handlingTime": {
                          "type": "object",
                          "properties": {
                            "@type": {
                              "type": "string"
                            },
                            "maxValue": {
                              "type": "number"
                            },
                            "minValue": {
                              "type": "number"
                            },
                            "unitCode": {
                              "type": "string"
                            }
                          },
                          "additionalProperties": false
                        },
                        "transitTime": {
                          "type": "object",
                          "properties": {
                            "@type": {
                              "type": "string"
                            },
                            "maxValue": {
                              "type": "number"
                            },
                            "minValue": {
                              "type": "number"
                            },
                            "unitCode": {
                              "type": "string"
                            }
                          },
                          "additionalProperties": false
                        }
                      },
                      "additionalProperties": false
                    },
                    "shippingDestination": {
                      "type": "object",
                      "properties": {
                        "@type": {
                          "type": "string"
                        },
                        "addressCountry": {
                          "type": "string"
                        }
                      },
                      "additionalProperties": false
                    },
                    "shippingRate": {
                      "type": "object",
                      "properties": {
                        "@type": {
                          "type": "string"
                        },
                        "currency": {
                          "type": "string"
                        },
                        "value": {
                          "type": "string"
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false
                },
                "url": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "sku": {
              "type": "string"
            },
            "url": {
              "type": "string"
            },
            "weight": {
              "type": "object",
              "properties": {
                "@type": {
                  "type": "string"
                },
                "unitCode": {
                  "type": "string"
                },
                "value": {
                  "type": "number"
                }
              },
              "additionalProperties": false
            },
            "width": {
              "type": "object",
              "properties": {
                "@type": {
                  "type": "string"
                },
                "unitCode": {
                  "type": "string"
                },
                "value": {
                  "type": "number"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false,
          "required": [
            "gtin14",
            "name"
          ],
          "anyOf": [
            {
              "required": [
                "@id",
                "@type"
              ]
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uri"
        },
        "kind": {
          "type": "string"
        },
        "uri": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uri"
          },
          "type": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "format": "uri"
          },
          "digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "claimPaths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "relatedHolons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "relation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uri"
          },
          "relation": {
            "type": "string",
            "format": "uri"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
